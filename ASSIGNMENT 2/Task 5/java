
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

class Team {

    final String name;
    final int points;
    final int goalDiff;

    Team(String name, int points, int goalDiff) {
        this.name = name;
        this.points = points;
        this.goalDiff = goalDiff;
    }

    @Override
    public String toString() {
        return name + "(" + points + "," + goalDiff + ")";
    }
}

class Leaderboard<T> {

    private final List<T> items = new ArrayList<>();

    private final Comparator<? super T> order;

    Leaderboard(Comparator<? super T> order) {
        this.order = order;
    }

    void add(T item) {
        items.add(item);
    }

    // TODO 1: Return a sorted copy without modifying items
    List<T> ranking() {

        List<T> sorted = new ArrayList<>(items);

        sorted.sort(order);

        return sorted;
    }
}

public class Main {

    public static void main(String[] args) {

        // TODO 2: Build comparator
        Comparator<Team> byRank =
            Comparator.comparingInt((Team t) -> t.points)
                .reversed()
                .thenComparing(
                    Comparator.comparingInt(
                        (Team t) -> t.goalDiff
                    ).reversed()
                )
                .thenComparing(t -> t.name);

        Leaderboard<Team> board =
            new Leaderboard<>(byRank);

        board.add(new Team("Panthers", 9, 4));
        board.add(new Team("Eagles", 9, 6));
        board.add(new Team("Cobras", 6, 1));
        board.add(new Team("Bisons", 9, 4));

        System.out.println("SPORTS LEADERBOARD");

        System.out.println("\nTeam Rankings:");

        System.out.println(board.ranking());

        // Additional test with ties
        System.out.println("\nAdditional Test:");

        Leaderboard<Team> secondBoard =
            new Leaderboard<>(byRank);

        secondBoard.add(new Team("Lions", 12, 8));
        secondBoard.add(new Team("Tigers", 12, 10));
        secondBoard.add(new Team("Bears", 12, 8));
        secondBoard.add(new Team("Wolves", 8, 3));

        System.out.println(secondBoard.ranking());

        // Check original list is not modified
        board.add(new Team("Sharks", 10, 5));

        System.out.println("\nOriginal Items Remain Stored:");
        System.out.println(board.ranking());
    }
}
